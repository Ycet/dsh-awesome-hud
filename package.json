{
  "name": "dsh-awesome-hud",
  "version": "0.21.5",
  "icon": "icon.png",
  "description": "DSH Web/桌面端插件：聊天页右上角「HUD面板」悬浮面板，展示会话与状态、上下文占用、一键压缩与交接、git 分支与变更、产物、子代理任务、任务、计划清单、MCP 开关、用量、便笺与待办；模块可置顶，面板开合与折叠状态按会话记忆，新建会话页提供悬浮入口。",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pretest": "node scripts/changelog-date.mjs",
    "changelog:date": "node scripts/changelog-date.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-subagent",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "icon.png",
    "docs/*.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ycet/dsh-awesome-hud.git"
  },
  "homepage": "https://github.com/Ycet/dsh-awesome-hud#readme",
  "bugs": {
    "url": "https://github.com/Ycet/dsh-awesome-hud/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "hud",
    "plugin"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
